# ===== Dr Shilpa Fertility chat assistant — settings =====
# In Coolify these go in: your app -> Environment Variables. (Locally: copy this file to .env)

# 1) Google Gemini key — get one at https://aistudio.google.com -> "Get API key"
#    For a health clinic, use a key from a Google Cloud project with BILLING ON (paid tier):
#    paid-tier chats are not used to train Google's models. Cost is a few hundred rupees a month at most.
GEMINI_API_KEY=paste_your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional free back-up AI if Gemini is busy (https://console.groq.com)
GROQ_API_KEY=

# 2) Password for the staff inbox at /admin — make up a strong one
ADMIN_TOKEN=choose-a-strong-password

# Minutes Asha waits after a staff reply before taking the chat back
HANDBACK_MINUTES=5

# 3) Keep chats and leads safe across redeploys (add a Coolify persistent storage at /app/data)
DATA_FILE=/app/data/data.json

# ----- OPTIONAL: email every booking/enquiry + log it in a Google Sheet (see README) -----
NOTIFY_WEBHOOK_URL=
# OR email only, via https://web3forms.com
WEB3FORMS_KEY=
NOTIFY_EMAIL=care@drshilpafertility.com
EMAIL_ALL_CHATS=false
EMAIL_AFTER_MIN=10

# Optional overrides (otherwise taken from clinic-config.json)
# CLINIC_PHONE_DISPLAY=+91 98775 14819
# CLINIC_PHONE_LINK=+919877514819
# CLINIC_WHATSAPP=919877514819
